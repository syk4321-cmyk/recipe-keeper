# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > cookmark-web 에서 확인한 값을 채워넣으세요.
# 값 자체는 비밀이 아니지만(클라이언트에 노출되는 게 Firebase 설계상 정상),
# 로컬 개발을 위해 이 파일을 .env로 복사해서 값을 채워야 합니다.
# (Netlify 배포용 값은 netlify.toml의 [build.environment]에 이미 들어있습니다.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
